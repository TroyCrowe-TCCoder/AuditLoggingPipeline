<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<Deterministic>true</Deterministic>
	<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	<NuGetAudit>true</NuGetAudit>
	<NuGetAuditLevel>moderate</NuGetAuditLevel>
	<NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <PropertyGroup>
	<PackageId>AuditLoggingPipeline.Models</PackageId>
	<Version>0.1.0</Version>
	<Authors>Troy Crowe</Authors>
	<Company>Single Source Management</Company>
	<Product>AuditLoggingPipeline.Models</Product>
	<Description>Shared audit contracts (AuditEntry, IAuditSink) consumed by the AuditLoggingPipeline core package and any sink implementations.</Description>
	<PackageTags>audit;logging;dotnet;contracts</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<RepositoryUrl>https://github.com/TroyCrowe-TCCoder/AuditLoggingPipeline</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
	<EmbedUntrackedSources>true</EmbedUntrackedSources>
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	<NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
